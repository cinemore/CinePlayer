    "Apple 翻译暂不支持该语言对，已自动关闭字幕翻译。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يدعم تطبيق ترجمة Apple زوج اللغات هذا. تم إيقاف ترجمة نصوص الحوار."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Traductor d’Apple no admet aquesta combinació d’idiomes. S’ha desactivat la traducció de subtítols."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Překladač Apple nepodporuje tuto dvojici jazyků. Překlad titulků byl vypnut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples Oversæt understøtter ikke dette sprogpar. Oversættelse af undertekster er slået fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Übersetzen unterstützt dieses Sprachpaar nicht. Die Untertitelübersetzung wurde deaktiviert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Μετάφραση της Apple δεν υποστηρίζει αυτό το ζεύγος γλωσσών. Η μετάφραση υποτίτλων απενεργοποιήθηκε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Translate does not support this language pair. Subtitle translation has been turned off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traducir de Apple no admite este par de idiomas. Se ha desactivado la traducción de subtítulos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applen Käännä ei tue tätä kieliparia. Tekstityksen käännös on poistettu käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduire d’Apple ne prend pas en charge cette paire de langues. La traduction des sous-titres a été désactivée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היישום ״תרגום״ של Apple אינו תומך בצמד השפות הזה. תרגום הכתוביות כובה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple अनुवाद इस भाषा जोड़ी का समर्थन नहीं करता। सबटाइटल अनुवाद बंद कर दिया गया है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleov Prevoditelj ne podržava ovaj jezični par. Prijevod titlova je isključen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Apple Fordító nem támogatja ezt a nyelvpárt. A feliratfordítás ki lett kapcsolva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjemahan Apple tidak mendukung pasangan bahasa ini. Terjemahan subtitle telah dinonaktifkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduci di Apple non supporta questa coppia di lingue. La traduzione dei sottotitoli è stata disattivata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleの翻訳はこの言語の組み合わせに対応していないため、字幕翻訳をオフにしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 번역이 이 언어 쌍을 지원하지 않아 자막 번역이 꺼졌습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples Oversett støtter ikke dette språkparet. Oversettelse av undertekster er slått av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Vertaal ondersteunt deze talencombinatie niet. Ondertitelvertaling is uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tłumacz Apple nie obsługuje tej pary języków. Tłumaczenie napisów zostało wyłączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Traduzir da Apple não oferece suporte a este par de idiomas. A tradução de legendas foi desativada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aplicação Traduzir da Apple não suporta este par de idiomas. A tradução de legendas foi desativada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicația Traducere de la Apple nu acceptă această pereche de limbi. Traducerea subtitrărilor a fost dezactivată."
