    "选择源语言和目标语言后，点击“下载语言包”可离线使用 Apple 翻译。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر لغتي المصدر والهدف، ثم اختر «تنزيل حزمة اللغة» لاستخدام ترجمة Apple دون اتصال."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria els idiomes d’origen i de destinació i selecciona «Descarrega el paquet d’idioma» per utilitzar el Traductor d’Apple sense connexió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte zdrojový a cílový jazyk a potom zvolte „Stáhnout jazykový balíček“, abyste mohli Překladač Apple používat offline."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg kilde- og målsprog, og vælg derefter “Hent sprogpakke” for at bruge Apples Oversæt offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quell- und Zielsprache auswählen und dann „Sprachpaket laden“ wählen, um Apple Übersetzen offline zu verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε γλώσσα προέλευσης και προορισμού και μετά «Λήψη πακέτου γλώσσας» για να χρησιμοποιήσετε τη Μετάφραση της Apple εκτός σύνδεσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the source and target languages, then select “Download Language Pack” to use Apple Translate offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige los idiomas de origen y destino y selecciona «Descargar paquete de idioma» para usar Traducir de Apple sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse lähde- ja kohdekieli ja sitten ”Lataa kielipaketti”, jotta voit käyttää Applen Käännä-sovellusta ilman verkkoyhteyttä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les langues source et cible, puis « Télécharger la langue » pour utiliser Traduire d’Apple hors ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבחור שפת מקור ושפת יעד, ואז לבחור ״הורדת חבילת שפה״ כדי להשתמש בתרגום Apple ללא חיבור לרשת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्रोत और लक्ष्य भाषाएँ चुनें, फिर Apple अनुवाद ऑफ़लाइन उपयोग करने के लिए “भाषा पैक डाउनलोड करें” चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite izvorni i ciljni jezik, a zatim „Preuzmi jezični paket” za izvanmrežnu upotrebu Appleova Prevoditelja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassza ki a forrás- és célnyelvet, majd a „Nyelvi csomag letöltése” lehetőséget az Apple Fordító offline használatához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih bahasa sumber dan target, lalu pilih “Unduh Paket Bahasa” untuk menggunakan Terjemahan Apple secara offline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli le lingue di origine e di destinazione, poi seleziona “Scarica pacchetto lingua” per usare Traduci di Apple offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原文と訳文の言語を選択し、「言語パックをダウンロード」を選ぶと、Appleの翻訳をオフラインで使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본 언어와 대상 언어를 선택한 다음 ‘언어 팩 다운로드’를 선택하면 Apple 번역을 오프라인으로 사용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg kilde- og målspråk, og velg deretter «Last ned språkpakke» for å bruke Apples Oversett uten nett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de bron- en doeltaal en selecteer ‘Download taalpakket’ om Apple Vertaal offline te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz język źródłowy i docelowy, a następnie „Pobierz pakiet językowy”, aby korzystać z Tłumacza Apple bez połączenia z siecią."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha os idiomas de origem e destino e selecione “Baixar pacote de idioma” para usar o Traduzir da Apple sem conexão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha os idiomas de origem e destino e selecione «Descarregar pacote de idioma» para usar a aplicação Traduzir da Apple offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți limba sursă și limba țintă, apoi selectați „Descărcați pachetul lingvistic” pentru a utiliza aplicația Traducere de la Apple offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите исходный и целевой языки, затем нажмите «Загрузить языковой пакет», чтобы использовать «Перевод» от Apple без интернета."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte zdrojový a cieľový jazyk a potom zvoľte „Stiahnuť jazykový balík“, aby ste mohli Prekladač Apple používať offline."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj käll- och målspråk och välj sedan ”Hämta språkpaket” för att använda Apples Översätt offline."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกภาษาต้นทางและภาษาปลายทาง แล้วเลือก “ดาวน์โหลดชุดภาษา” เพื่อใช้แอปแปลภาษาของ Apple แบบออฟไลน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaynak ve hedef dilleri seçin, ardından Apple Çeviri’yi çevrimdışı kullanmak için “Dil Paketini İndir” seçeneğini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть вихідну та цільову мови, а потім натисніть «Завантажити мовний пакет», щоб користуватися «Перекладом» від Apple офлайн."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn ngôn ngữ nguồn và đích, rồi chọn “Tải gói ngôn ngữ” để sử dụng Dịch của Apple ngoại tuyến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择源语言和目标语言后，点击“下载语言包”可离线使用 Apple 翻译。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇來源語言與目標語言後，點選「下載語言包」即可離線使用 Apple 翻譯。"
          }
        }
      }
    },
