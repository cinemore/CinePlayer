    "tvOS 使用系统焦点交互，不展示分段字幕面板。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم tvOS التنقل بتركيز النظام ولا يعرض لوحة الترجمة النصية المقسّمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tvOS utilitza la navegació per focus del sistema i no mostra el tauler segmentat de subtítols."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS používá systémovou navigaci pomocí zaměření a nezobrazuje segmentovaný panel titulků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS bruger systemets fokusnavigation og viser ikke det segmenterede undertekstpanel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS verwendet die Fokusnavigation des Systems und zeigt kein segmentiertes Untertitelfeld an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το tvOS χρησιμοποιεί την πλοήγηση εστίασης του συστήματος και δεν εμφανίζει τον τμηματοποιημένο πίνακα υποτίτλων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS uses system focus navigation and does not show the segmented subtitle panel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS utiliza la navegación de enfoque del sistema y no muestra el panel segmentado de subtítulos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS käyttää järjestelmän kohdistusnavigointia eikä näytä osiin jaettua tekstityspaneelia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS utilise la navigation système par focus et n’affiche pas le panneau segmenté des sous-titres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS משתמש בניווט המיקוד של המערכת ואינו מציג את לוח הכתוביות המחולק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS सिस्टम फ़ोकस नेविगेशन का उपयोग करता है और विभाजित सबटाइटल पैनल नहीं दिखाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS koristi navigaciju fokusom sustava i ne prikazuje segmentiranu ploču titlova."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tvOS a rendszer fókuszalapú navigációját használja, és nem jeleníti meg az osztott feliratpanelt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS menggunakan navigasi fokus sistem dan tidak menampilkan panel subtitle bersegmen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS utilizza la navigazione tramite focus del sistema e non mostra il pannello segmentato dei sottotitoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOSではシステムのフォーカス操作を使用するため、字幕のセグメントパネルは表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS는 시스템 포커스 탐색을 사용하며 분할된 자막 패널을 표시하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS bruker systemets fokusnavigering og viser ikke det segmenterte undertekstpanelet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS gebruikt de focusnavigatie van het systeem en toont geen gesegmenteerd ondertitelpaneel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS korzysta z systemowej nawigacji fokusem i nie wyświetla segmentowego panelu napisów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tvOS usa a navegação por foco do sistema e não exibe o painel segmentado de legendas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tvOS utiliza a navegação por foco do sistema e não apresenta o painel segmentado de legendas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS folosește navigarea prin focalizare a sistemului și nu afișează panoul segmentat de subtitrări."
          }
